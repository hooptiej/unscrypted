# Copy to .env next to docker-compose.yml and fill in. .env is per-install and never committed
# (nothing here is a secret — the admin password lives in ./secrets/admin_password).

# Which release to run. No default: compose refuses to start without it. Images are never :latest.
UNSCRYPTED_VERSION=

# --- install-specific (optional; empty = the app's own default) ---------------------------------
# Pin the HomeKit (HAP) server + mDNS advertisement to one host address. Empty = every address.
# Set it on a host with more than one address, e.g. UNSCRYPTED_HAP_BIND=10.0.0.5
# UNSCRYPTED_HAP_BIND=

# Give the watch-only dashboard its own address/URL (when it lives apart from the admin pane).
# Empty = same host, every address.
# UNSCRYPTED_DASH_HOST=              # the one address the dashboard listens on
# UNSCRYPTED_DASH_URL=              # the dashboard's public URL, e.g. http://dashboard.local/
# UNSCRYPTED_ADMIN_URL=            # the admin pane's URL (when the dashboard is elsewhere), e.g. http://host:8190
# UNSCRYPTED_DASH_PORT=8180        # the living-room dashboard's port (some installs use 80)

# Extra debug logging (empty = off), e.g.:
# UNSCRYPTED_DEBUG=HAP-NodeJS:Camera*,HAP-NodeJS:EventedHTTPServer*

# --- ports: override only to avoid a clash with something else on the host network --------------
# UNSCRYPTED_LOG_LEVEL=info
# UNSCRYPTED_ADMIN_PORT=8190
# UNSCRYPTED_GO2RTC_API_PORT=1986
# UNSCRYPTED_GO2RTC_WEBRTC_PORT=8557
# UNSCRYPTED_GO2RTC_RTSP_PORT=8554
# UNSCRYPTED_LIVE_SOURCE=camera

# A second instance on the same host (the test install), run from its own folder (~/unscrypted-test):
# COMPOSE_FILE=docker-compose.yml:docker-compose.test.yml
